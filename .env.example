# Copy to .env (never commit it). Every setting is optional.

# Require "Authorization: Bearer <token>" on every endpoint except /health.
# Empty: no token needed.
API_TOKEN=

# Use another data file than example_api/data.json.
DATA_FILE=

# Where `python main.py` listens (the image always listens on 0.0.0.0).
HOST=127.0.0.1
PORT=8000
